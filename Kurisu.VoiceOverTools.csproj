<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendTargetFrameworkToIntermediateOutputPath>false</AppendTargetFrameworkToIntermediateOutputPath>

    <Configurations>Debug;Release</Configurations>
    <!-- false: Articy.MDK 2.4.1 pulls System.Drawing.Common and friends in transitively; articy ships its own
         copies, so the plugin must not carry second ones into its process. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <UseWPF>true</UseWPF>
    <ProduceReferenceAssembly>True</ProduceReferenceAssembly>

    <!-- Keep in step with PluginManifest.xml: articy reuses an already-loaded assembly with the same
         identity, so an update installed without a restart can keep running the old code. -->
    <Version>1.1.7</Version>
  </PropertyGroup>

  <!-- The articy-free tests live in Tests/ as their own project; keep them out of the plugin. -->
  <ItemGroup>
    <Compile Remove="Tests/**" />
    <None Remove="Tests/**" />
    <Page Remove="Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Articy.MDK" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="PluginTexts.Generated.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>PluginTexts.tpk</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="PluginManifest.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="PluginTexts.tpk">
      <Generator>BuildTextConsts</Generator>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <LastGenOutput>PluginTexts.Generated.cs</LastGenOutput>
    </None>
    <None Update="Resources\Icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
